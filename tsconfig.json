{
  "compilerOptions": {
    "target": "ES2020",

    "rootDir": "src",
    "outDir": "dist",

    "types": [
      "google-apps-script"
    ],

    "strict": true,
    "skipLibCheck": true,

    "removeComments": false,
    "sourceMap": false
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}